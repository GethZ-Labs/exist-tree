# Environment settings for the EXiST website.
# Local: copy this file to `.env.local`. Render: add them under Environment.
# Every value is optional — without email settings the form still works, it
# just asks visitors to send the enquiry on WhatsApp or by email instead.

# ---------------------------------------------------------------------------
# Contact form email — choose ONE option
# ---------------------------------------------------------------------------

# 1) Web3Forms (easiest, free, works on Render's free plan).
#    Get a key at https://web3forms.com by entering existofficial7@gmail.com.
#    The key is meant to be public, so it's safe in the browser.
NEXT_PUBLIC_WEB3FORMS_KEY=

# 2) Gmail SMTP: needs 2-Step Verification and an App Password
#    (https://myaccount.google.com/apppasswords). Some free hosting plans
#    block outgoing SMTP — if mail doesn't arrive there, use option 1.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# 3) Resend (https://resend.com): sign up with the inbox that should receive
#    the enquiries, then paste the API key.
RESEND_API_KEY=
# RESEND_FROM=EXiST Website <onboarding@resend.dev>

# Where enquiries are delivered (default: the email in src/lib/site.ts).
# ENQUIRY_TO=existofficial7@gmail.com

# ---------------------------------------------------------------------------
# Site address for link previews (Render provides RENDER_EXTERNAL_URL itself).
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
